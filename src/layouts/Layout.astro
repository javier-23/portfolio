---
import Header from "../components/Header.astro";
import "../styles/global.css";
import '@fontsource-variable/roboto/wght.css';
import Footer from "../components/Footer.astro";
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/terminal.svg" media="(prefers-color-scheme: light)"/>
		<link rel="icon" type="image/svg+xml" href="/terminal-white.svg" media="(prefers-color-scheme: dark)" />
		<link rel="icon" href="/terminal.ico"/>
		<meta name="description" content="Contratame como desarrollador web full-stack" />
		<title>Porfolio - Javier Mora</title>
	</head>
	<body>
		<Header />
		<main class="px-6">
			<slot /> 
		</main>
		<Footer />
	</body>
</html>

<style>
	:root{
		
	}
	html{ 
		font-family: 'Roboto Variable', sans-serif;
		background: rgb(2, 2, 30);
		scroll-behavior: smooth;
	}
	body {
		margin: 0;
		display: flex;
		flex-direction: column;
		min-height: 100vh;
	}

	/* Evitar que el scroll suave afecte a usuarios con preferencias de reducción de movimiento */
	@media (prefers-reduced-motion: reduce) {
		html {
			scroll-behavior: auto;
		}
	}
</style>
