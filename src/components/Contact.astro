---
import Github from '../icons/GitHub.astro';
import Mail from '../icons/Mail.astro';
import LinkedIn from '../icons/LinkedIn.astro';
import SocialNetwork from './SocialNetwork.astro';
---

<div>
    <form action="https://formspree.io/f/mpqnedqo"
          method="POST">
        <input type="text" name="name" placeholder="Tu nombre" required
               class="w-full p-3 rounded-lg bg-gray-800 text-white mb-4 focus:outline-none focus:ring-2 focus:ring-blue-500"
        />
        <input type="email" name="email" placeholder="Tu correo electrónico" required
               class="w-full p-3 rounded-lg bg-gray-800 text-white mb-4 focus:outline-none focus:ring-2 focus:ring-blue-500"
        />
        <textarea name="message" placeholder="Tu mensaje" required
                  class="w-full p-3 rounded-lg bg-gray-800 text-white mb-4 h-32 resize-none focus:outline-none focus:ring-2 focus:ring-blue-500"></textarea>
        <input type="hidden" name="_subject" 
               value="Mensaje desde mi portafolio"
        />
        <button type="submit" class="px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors duration-300 cursor-pointer">
            Enviar
        </button>
    </form>
</div>
<div class="flex items-center justify-center h-full flex-col">
    <h3 class="text-primary-white/90 text-xl font-semibold">
        También puedes conocerme a través de:
    </h3>
    <nav>
        <ul class="flex mt-6 justify-center">
            <li class="flex gap-4">
                <SocialNetwork 
                    icon={Github} 
                    text="GitHub" 
                    className="bg-gray-800 text-primary-white/90 hover:bg-primary-blue/60" 
                    href="https://github.com/javier-23" 
                />
                <SocialNetwork 
                    icon={LinkedIn} 
                    text="LinkedIn" 
                    className="bg-gray-800 text-primary-white/90 hover:bg-primary-blue/60"
                    href="https://www.linkedin.com/in/javiermoraov/" 
                />
                <SocialNetwork
                    icon={Mail} 
                    text="Correo" 
                    className="bg-gray-800 text-primary-white/90 hover:bg-primary-blue/60" 
                    href="mailto:j.moraov@gmail.com"
                />
            </li>
        </ul>
    </nav>
</div>