---
import Header from "../components/Header.astro";
import "../styles/global.css";
import '@fontsource-variable/roboto/wght.css';
import Footer from "../components/Footer.astro";

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Javier Mora | Desarrollador web full-stack",
	description = "Portfolio de Javier Mora Ortiz-Villajos, desarrollador web full-stack. Conoce mi experiencia, proyectos y habilidades en desarrollo web."
} = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/terminal.svg" media="(prefers-color-scheme: light)"/>
		<link rel="icon" type="image/svg+xml" href="/terminal-white.svg" media="(prefers-color-scheme: dark)" />
		<link rel="icon" href="/terminal.ico"/>
		<meta name="description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="google-site-verification" content="suZskd6L7eMMgtTLGxKR8RXqHlc6CV5slbw8azC7ng8" />
		<title>{title}</title>
	</head>
	<body>
		<Header />
		<main class="px-6 sm:px-0">
			<slot /> 
		</main>
		<Footer />
	</body>
</html>

<style>
	:root{
		
	}
	html{ 
		font-family: 'Roboto Variable', sans-serif;
		background: rgb(2, 2, 30);
		scroll-behavior: smooth;
	}
	body {
		margin: 0;
		display: flex;
		flex-direction: column;
		min-height: 100vh;
	}

	/* Evitar que el scroll suave afecte a usuarios con preferencias de reducción de movimiento */
	@media (prefers-reduced-motion: reduce) {
		html {
			scroll-behavior: auto;
		}
	}
</style>
