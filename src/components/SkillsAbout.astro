---
import TechnologySpan from './TechnologySpan.astro';
import { TECHNOLOGIES } from '../data/technologies';
type TechKey = keyof typeof TECHNOLOGIES;
const { title, className, skills } = Astro.props as { title: string; className?: string; skills: TechKey[] };
---
<article class={`shadow-lg shadow-blue-600/50 border-2 border-primary-white/20 rounded-lg p-2 mt-2 ${className ?? ''}`}>
    <h3 class="text-primary-white/90 font-bold text-lg mb-2 flex justify-center items-center">
        {title}
    </h3>
    <ul class="flex flex-wrap gap-2 justify-center items-center mb-2">
        {skills.map((skill) => (
            <TechnologySpan techKey={skill} />
        ))}
    </ul>
</article>