---
import TechnologySpan from './TechnologySpan.astro';

const PROJECTS = [
    {
        name: "Portafolio Personal",
        description: "Mi portafolio personal, construido con Astro y Tailwind CSS, diseñado para mostrar mis habilidades y proyectos de manera atractiva y profesional.",
        link: "",
        image: "projects/portfolio1.webp",
        technologies: ["astro", "tailwind"]
    },
    {
        name: "Gestor de Tareas",
        description: "Una aplicación web para gestionar tareas diarias, con funcionalidades de creación, edición y eliminación de tareas, utilizando React y Node.js.",
        link: "",
        image: "projects/portfolio1.webp",
        technologies: ["react", "nodejs", "javascript"]
    },
    {
        name: "Blog Personal",
        description: "Un blog personal donde comparto mis experiencias y conocimientos en desarrollo web, construido con Gatsby y GraphQL para un rendimiento óptimo.",
        link: "",
        image: "projects/portfolio1.webp",
        technologies: []
    }
]
---

{
    /* Aquí se renderizarán los proyectos utilizando el array PROJECTS */
    PROJECTS.map((project) => (
        <article class="bg-gray-800 rounded-lg cursor-pointer overflow-hidden p-4
                        hover:scale-105 transition-transform duration-300 shadow-md hover:shadow-[0_0_30px_rgba(59,130,246,0.45)]">
            <img src={project.image} alt={project.name} class="w-full h-auto mb-4"/>
            <h3 class="text-xl font-bold text-primary-white mb-2">{project.name}</h3>
            <p class="text-secondary-gray/80 mb-5">{project.description}</p>
            <ul class="flex flex-wrap gap-3">
                {project.technologies.map((tech) => (
                    <li>
                        <TechnologySpan techKey={tech} />
                    </li>
                ))}
            </ul>
        </article>
    ))

}