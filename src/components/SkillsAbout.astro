---
import TechnologySpan from './TechnologySpan.astro';
import { TECHNOLOGIES } from '../data/technologies';

type TechKey = keyof typeof TECHNOLOGIES;

const { title, skills, className = '' } = Astro.props as {
  title: string;
  skills: TechKey[];
  className?: string;
};
---

<article
  class={`h-full rounded-xl border border-primary-white/10 bg-black/20 p-4 shadow-[0_0_20px_rgba(21,93,252,0.06)] transition-all duration-300 hover:border-primary-white/20 hover:bg-white/5 ${className}`}
>
  <h3 class="mb-3 flex items-center justify-center text-lg font-bold text-primary-white/90">
    {title}
  </h3>     

  <ul class="flex flex-wrap justify-center gap-2">
    {skills.map((skill) => (
      <li>
        <TechnologySpan techKey={skill} />
      </li>
    ))}
  </ul>
</article>