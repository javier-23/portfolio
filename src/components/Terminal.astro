---
import TextType from '../components/TextType.tsx';
---

<div class="rounded-lg w-34/100 h-90 bg-gray-900/80 shadow-[0_0_30px_rgba(59,130,246,0.45)] overflow-hidden flex flex-col">
    <!--Seccion superior -->
    <div class="bg-gray-800 flex">
        <div class="flex justify-between items-center p-2 gap-2">
            <div class="rounded-full w-3 h-3 bg-red-500"></div>
            <div class="rounded-full w-3 h-3 bg-yellow-500"></div>
            <div class="rounded-full w-3 h-3 bg-green-500"></div>
        </div>
        <div class="flex items-center justify-center w-full">
            <p class="text-gray-500 text-xs">bash - 80x24 </p>
        </div>
    </div>
    <!--Seccion inferior -->
    <div class="pl-6 pr-6 flex flex-col justify-center gap-4 flex-1">
        <TextType
        client:visible
        as="h1"
        className="xl:text-5xl text-3xl text-white font-bold"
        text={["Hola, soy Javier Mora", "¡Bienvenid@ a mi porfolio!"]}
        typingSpeed={100}
        pauseDuration={3500}
        deletingSpeed={40}
        showCursor
        cursorCharacter="|"
        startOnVisible
        loop
        />
		<div class="flex">
            <svg 
                xmlns="http://www.w3.org/2000/svg" 
                width="30" height="30" viewBox="0 0 30 30" 
                fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" 
                class="icon icon-tabler icons-tabler-outline icon-tabler-chevron-right text-gray-300 ">
                <path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M9 6l6 6l-6 6" /></svg>
            <p class="text-gray-300 xl:text-lg text-md font-jetbrains">Desarrollador <span class="bg-linear-to-r from-indigo-500 via-blue-400 to-sky-300 bg-clip-text text-transparent">Full-Stack</span> especializado en tecnologías web modernas.</p>
        </div>
    </div>
</div>