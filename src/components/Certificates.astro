---
import CertificateItem from './CertificateItem.astro';

const CERTIFICATES = [
  {
    title: 'Certificado Bootcamp Desarrollo Full Stack',
    date: 'Septiembre 2026',
    issuer: 'JSCamp Bootcamp',
    description: 'Bootcamp de desarrollo sobre HTML, CSS, JavaScript, React, Node.js con Express, Testing, TypeScript, Inteligencia Artificial, SQL, Agentes de Código, CI/CD y Docker',
    type: 'Online',
    href: '/certificates/Certificado-JSCamp.pdf'
  },
  {
    title: 'Certificado Fundamentos SQL',
    date: 'Junio 2026',
    issuer: 'DataCamp',
    description: 'Curso de fundamentos de SQL, aprendiendo a consultar y manipular bases de datos relacionales.',
    type: 'Online',
    href: '/certificates/certificate-sql-fundamentals.pdf'
  },
  {
    title: 'Certificado Introducción a Docker',
    date: 'Julio 2026',
    issuer: 'DataCamp',
    description: 'Curso de introducción a Docker, aprendiendo a crear y gestionar contenedores.',
    type: 'Online',
    href: '/certificates/certificate-intro-docker.pdf'
  },
  {
    title: 'Conceptos de Contenerización y Virtualización',
    date: 'Julio 2026',
    issuer: 'DataCamp',
    description: 'Curso de conceptos de contenerización y virtualización, aprendiendo a crear y gestionar entornos aislados.',
    type: 'Online',
    href: '/certificates/certificate-intro-conceptos.pdf'
  },
  {
    title: 'Curso Básico de Ciberseguridad',
    date: 'Marzo 2026',
    issuer: 'CCN',
    description: 'Curso introductorio a la ciberseguridad, cubriendo conceptos fundamentales y mejores prácticas.',
    type: 'Online',
    href: '/certificates/CursoBasicoCiberseguridad.pdf'
  },
  {
    title: 'Curso de gestión de incidentes de ciberseguridad',
    date: 'Mayo 2026',
    issuer: 'CCN',
    description: 'Tipos de incidentes, la gestión de estos, y casos prácticos para notificarlos.',
    type: 'Online',
    href: '/certificates/Curso_gestion_incidentes.pdf'
  },
];
---

<div class="w-full grid grid-cols-1 md:grid-cols-2 gap-8">
  {CERTIFICATES.map(cert => (
    <CertificateItem {...cert} />
  ))}
</div>