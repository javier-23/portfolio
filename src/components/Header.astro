<header class="flex justify-between items-center w-full
                py-3 sm:py-6 sm:px-30 px-10
                shadow-lg shadow-blue-600/50
                sticky top-0 z-50 
                bg-gray-900/80 backdrop-blur-sm"
>
    <div class="flex items-center space-x-4">
        <h2 class="text-white md:text-2xl text-md font-bold">Porfolio</h2>
    </div>
    
    <nav class="hidden lg:flex space-x-10 md:text-xl text-md text-secondary-gray opacity-80">
        <a href="#home" class="hover:text-blue-400 hover:drop-shadow-[0_0_8px_rgba(6,182,212,0.8)]">Home</a>
        <a href="#experience" class="hover:text-blue-400 hover:drop-shadow-[0_0_8px_rgba(6,182,212,0.8)]">Experiencia</a>
        <a href="#projects" class="hover:text-blue-400 hover:drop-shadow-[0_0_8px_rgba(6,182,212,0.8)]">Proyectos</a>
        <a href="#about" class="hover:text-blue-400 hover:drop-shadow-[0_0_8px_rgba(6,182,212,0.8)]">Sobre mí</a>
        <a href="#contact" class="hover:text-blue-400 hover:drop-shadow-[0_0_8px_rgba(6,182,212,0.8)]">Contacto</a> 
    </nav>

    <button id="mobile-menu-button" aria-expanded="false" aria-controls="mobile-menu" class="ml-auto lg:hidden p-2 rounded-md text-secondary-gray hover:text-white focus:outline-none focus:ring-2 focus:ring-blue-400">
        <svg id="icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
        <svg id="icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
    </button>
     
    <div id="mobile-menu" class="md:hidden">
        <div class="absolute top-full right-0 w-full px-4 sm:px-6 lg:px-8 text-primary-white">
            <div class="mt-2 mb-4 bg-gray-900 border border-white/20 rounded-md shadow-xl shadow-black py-3 px-3 flex flex-col space-y-2">
                <a href="#home" class="px-3 py-2 rounded hover:bg-gray-700/60">Home</a>
                <a href="#experience" class="px-3 py-2 rounded hover:bg-gray-700/60">Experiencia</a>
                <a href="#projects" class="px-3 py-2 rounded hover:bg-gray-700/60">Proyectos</a>
                <a href="#about" class="px-3 py-2 rounded hover:bg-gray-700/60">Sobre mí</a>
                <a href="#contact" class="px-3 py-2 rounded hover:bg-gray-700/60">Contacto</a>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
        const btn = document.getElementById('mobile-menu-button');
        const menu = document.getElementById('mobile-menu');
        const iconOpen = document.getElementById('icon-open');
        const iconClose = document.getElementById('icon-close');
        if (!btn || !menu) return;
        btn.addEventListener('click', () => {
            const opened = btn.getAttribute('aria-expanded') === 'true';
            btn.setAttribute('aria-expanded', String(!opened));
            menu.classList.toggle('hidden');
            iconOpen?.classList.toggle('hidden');
            iconClose?.classList.toggle('hidden');
        });
        // Cerrar al clicar en un enlace
        menu.querySelectorAll('a').forEach(a => a.addEventListener('click', () => {
            btn.setAttribute('aria-expanded','false');
            menu.classList.add('hidden');
            iconOpen?.classList.remove('hidden');
            iconClose?.classList.add('hidden');
        }));
        // Inicialmente oculto
        menu.classList.add('hidden');
        });
    </script>
</header>