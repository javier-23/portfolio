---
import Briefcase from '../icons/Briefcase.astro';
import Code from '../icons/Code.astro';
import Contact from '../components/Contact.astro';
import Experience from '../components/Experience.astro';
import Layout from '../layouts/Layout.astro';
import Message from '../icons/Message.astro';
import Projects from '../components/Projects.astro';
import Terminal from '../components/Terminal.astro';
import CircuitBackground from '../components/CircuitBackground.astro';
import About from '../components/About.astro';
---

<Layout title="Portfolio de Javier Mora - Programador y desarrollador web" 
		description="Bienvenido a mi portfolio, soy un desarrollador web full-stack especializado en tecnologías modernas. Explora mis proyectos y habilidades en desarrollo web."
>
	<main>
		<!-- Sección de bienvenida -->
		<section class="min-h-screen flex flex-col justify-center items-center" id="home">
			<CircuitBackground/>
			<div class="w-full flex justify-center items-center gap-20 -mt-40">	
				<Terminal/>
				<div class="size-80 rounded-full overflow-hidden border-2 border-blue-600">
					<img src="/perfil.png" alt="perfil" class="w-full h-full object-cover" />
				</div>
			</div>

			<div class="main__action absolute size-15 bottom-10 left-1/2"> 
				<a class="main__scroll" href="#experience">
					<svg class="text-cyan-400 shadow-blue" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
						<path d="M0 0h24v24H0z" fill="none"></path>
						<path d="M11.9997 13.1716L7.04996     8.22186L5.63574 9.63607L11.9997 16L18.3637 9.63607L16.9495 8.22186L11.9997 13.1716Z" fill="currentColor">
						</path>
					</svg>
				</a>
			</div>
		</section>

		<section class="flex justify-center mt-10 mb-20" id="experience">
			<div class="w-full max-w-4xl flex flex-col items-start">
				<h2 class="flex items-center text-4xl font-bold text-primary-white mb-8">
					<Briefcase class="size-9 text-primary-white me-2"/>
					Experiencia laboral y académica
				</h2>
				<Experience/>
			</div>
		</section>

		<section class="flex justify-center mt-10 mb-20" id="projects">
			<div class="w-full max-w-4xl flex flex-col items-start">
				<h2 class="flex items-center text-4xl font-bold text-primary-white mb-8">
					<Code class="size-9 text-primary-white me-2"/>
					Proyectos
				</h2>
				<div class="w-full grid md:grid-cols-2 gap-8">
					<Projects/>
				</div>
			</div>
		</section>

		<section class="flex justify-center mt-10 mb-20" id="about">
			<div class="w-full max-w-4xl flex flex-col items-start">
				<h2 class="flex items-center text-4xl font-bold text-primary-white mb-8">
					<Code class="size-9 text-primary-white me-2"/>
					Sobre mí
				</h2>
				<div class="w-full grid md:grid-cols-2 gap-1">
					<About/>
				</div>
			</div>
		</section>

		<section class="flex justify-center mt-10 mb-20" id="contact">
			<div class="w-full max-w-4xl flex flex-col items-start">
				<h2 class="flex items-center text-4xl font-bold text-primary-white mb-8">
					<Message class="size-8 text-primary-white me-2"/>
					Contacto
				</h2>
				<div class="w-full grid md:grid-cols-2 gap-8">
					<Contact/>
				</div>
			</div>
		</section>
	</main>
</Layout>
