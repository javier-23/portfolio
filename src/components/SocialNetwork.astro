<!-----
    Componente para mostrar un enlace a una red social con un icono y texto junto a animacion.
    Props:
        - href: URL del enlace
        - icon: Componente de icono
        - text: Texto a mostrar junto al icono
        - className: Clases CSS adicionales para personalizar el estilo
--- -->
<a  href={Astro.props.href} 
    target="_blank" rel="noopener noreferrer" 
    class={`group flex items-center text-lg rounded-3xl px-3 py-2 cursor-pointer ${Astro.props.className}`}>
        <Astro.props.icon class="size-10 text-gray-400 group-hover:text-primary-white/80"/>
        <span class="max-w-0 opacity-0 ml-0 overflow-hidden whitespace-nowrap
                    -translate-x-1
                    ease-in-out duration-500
                    group-hover:ml-2 group-hover:max-w-40 group-hover:opacity-100
                    group-hover:translate-x-0 group-hover:animate-fade-in-right">
            {Astro.props.text}
        </span>
</a>