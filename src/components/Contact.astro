---
import Github from '../icons/GitHub.astro';
import Mail from '../icons/Mail.astro';
import LinkedIn from '../icons/LinkedIn.astro';
import SocialNetwork from './SocialNetwork.astro';
---

<div>
    <form>
        <input type="text" placeholder="Tu nombre" class="w-full p-3 rounded-lg bg-gray-800 text-white mb-4 focus:outline-none focus:ring-2 focus:ring-blue-500"/>
        <input type="email" placeholder="Tu correo electrónico" class="w-full p-3 rounded-lg bg-gray-800 text-white mb-4 focus:outline-none focus:ring-2 focus:ring-blue-500"/>
        <textarea placeholder="Tu mensaje" class="w-full p-3 rounded-lg bg-gray-800 text-white mb-4 h-32 resize-none focus:outline-none focus:ring-2 focus:ring-blue-500"></textarea>
        <button type="submit" class="px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors duration-300 cursor-pointer">Enviar</button>
    </form>
</div>
<div>
    <h3 class="flex justify-center text-primary-white/90 text-xl font-bold mt-6">
        También puedes conocerme a través de:
    </h3>
    <nav>
        <ul class="flex mt-6 justify-center">
            <li class="flex gap-4">
                <SocialNetwork icon={Github} text="GitHub" className="bg-indigo-400/60 text-primary-white/80 hover:bg-blue-600/20" />
                <SocialNetwork icon={LinkedIn} text="LinkedIn" className="bg-blue-700/50 text-primary-white/80 hover:bg-blue-600/20" />
                <SocialNetwork icon={Mail} text="Correo" className="bg-blue-600/10 text-primary-white/80 hover:bg-blue-600/20" />
            </li>
        </ul>
    </nav>
</div>